# Copy to .env in repo root (backend reads via pydantic-settings)
DATABASE_URL=postgresql+asyncpg://paten:paten@localhost:5433/paten
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIPS_LIVE_ENABLED=true
FIPS_LIVE_MAX_RESULTS=25
FIPS_SEARCH_CACHE_TTL=300
FIPS_LIVE_TIMEOUT_SEC=90
# Если ошибка ChromeDriver mismatch — укажите major-версию Chrome (148, 149, …)
CHROME_VERSION_MAIN=148

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
